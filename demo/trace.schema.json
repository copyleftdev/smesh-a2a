{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/copyleftdev/smesh-a2a/demo/trace.schema.json",
  "title": "SMESH A2A cinematic trace event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "eventId",
    "sequence",
    "simTimeMs",
    "layer",
    "kind",
    "source",
    "target",
    "correlation",
    "message",
    "metrics",
    "integrity"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "type": "string", "minLength": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "simTimeMs": { "type": "integer", "minimum": 0 },
    "wallTime": { "type": ["string", "null"], "format": "date-time" },
    "layer": {
      "enum": ["a2a", "smesh", "tool", "artifact", "human", "system"]
    },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
    "source": { "$ref": "#/$defs/actor" },
    "target": {
      "oneOf": [
        { "$ref": "#/$defs/actor" },
        { "type": "null" }
      ]
    },
    "correlation": { "$ref": "#/$defs/correlation" },
    "message": { "$ref": "#/$defs/message" },
    "state": {
      "type": ["string", "null"],
      "enum": [
        null,
        "discovered",
        "submitted",
        "working",
        "input-required",
        "completed",
        "failed",
        "canceled",
        "rejected",
        "emitted",
        "sensed",
        "claimed",
        "reinforced",
        "backed-off",
        "decayed",
        "contested",
        "ratified"
      ]
    },
    "metrics": { "$ref": "#/$defs/metrics" },
    "payload": { "type": "object" },
    "visual": { "$ref": "#/$defs/visual" },
    "narration": { "$ref": "#/$defs/narration" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lon", "lat"],
      "properties": {
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "alt": { "type": "number", "default": 0 }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "organization", "role", "geo"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "organization": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "endpoint": { "type": ["string", "null"], "format": "uri" },
        "geo": { "$ref": "#/$defs/geo" }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId", "spanId"],
      "properties": {
        "traceId": { "type": "string", "minLength": 1 },
        "spanId": { "type": "string", "minLength": 1 },
        "parentSpanId": { "type": ["string", "null"] },
        "contextId": { "type": ["string", "null"] },
        "taskId": { "type": ["string", "null"] },
        "signalId": { "type": ["string", "null"] },
        "artifactId": { "type": ["string", "null"] },
        "toolCallId": { "type": ["string", "null"] }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "modality", "redacted"],
      "properties": {
        "summary": { "type": "string", "maxLength": 280 },
        "modality": {
          "enum": ["none", "text", "data", "file", "geojson", "form", "audio", "video"]
        },
        "contentHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "redacted": { "type": "boolean" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intensity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "trust": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "reinforcement": { "type": ["integer", "null"], "minimum": 0 },
        "latencyMs": { "type": ["integer", "null"], "minimum": 0 },
        "payloadBytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "importance": { "type": "number", "minimum": 0, "maximum": 1 },
        "cameraFocus": { "type": ["string", "null"] },
        "paletteKey": { "type": ["string", "null"] },
        "holdMs": { "type": "integer", "minimum": 0 }
      }
    },
    "narration": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "cueId": { "type": "string" },
        "line": { "type": "string" },
        "voice": { "type": "string" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prevHash", "eventHash"],
      "properties": {
        "prevHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "eventHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "signature": { "type": ["string", "null"] }
      }
    }
  }
}
